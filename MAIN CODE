module moore_101_overlap (
    input clk,
    input reset,
    input x,
    output reg y
);

    reg [1:0] state, next_state;

    // State update
    always @(posedge clk or posedge reset) begin
        if (reset)
            state <= 2'b00; // S0
        else
            state <= next_state;
    end

    // Next state logic
    always @(*) begin
        case (state)
            2'b00: next_state = (x) ? 2'b01 : 2'b00; // S0
            2'b01: next_state = (x) ? 2'b01 : 2'b10; // S1
            2'b10: next_state = (x) ? 2'b11 : 2'b00; // S2
            2'b11: next_state = (x) ? 2'b01 : 2'b10; // S3 (overlap handled)
        endcase
    end

    // Output logic (Moore)
    always @(*) begin
        case (state)
            2'b11: y = 1;
            default: y = 0;
        endcase
    end

endmodule




