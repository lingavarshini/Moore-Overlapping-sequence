    moore_101_overlapp dut (
        .clk(clk),
        .reset(reset),
        .x(x),
        .y(y)
    );

    // Clock generation (10ns period)
    always #5 clk = ~clk;

    // Stimulus
    initial begin
        // Initialize signals
        clk = 0;
        reset = 1;
        x = 0;

        #10;
        reset = 0;

        // Input sequence: 1 0 1 0 1 (should detect 101 twice due to overlap)
        #10 x = 1;
        #10 x = 0;
        #10 x = 1;
        #10 x = 0;
        #10 x = 1;

        // Add some idle time
        #20;

        $finish;
    end

endmodule
